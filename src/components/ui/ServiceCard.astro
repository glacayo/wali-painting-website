---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  imageSrc: ImageMetadata;
  imageAlt: string;
}

const { title, description, imageSrc, imageAlt } = Astro.props;
---

<div class="bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 group">
  <div class="aspect-[4/3] overflow-hidden">
    <Image 
      src={imageSrc} 
      alt={imageAlt}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      widths={[240, 320, 384, 448, 512]}
      sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1023px) calc((100vw - 5rem) / 2), calc((min(100vw, 80rem) - 8rem) / 3)"
      quality={60}
      format="webp"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="p-6">
    <h3 class="font-heading font-bold text-xl text-brand-dark mb-3">{title}</h3>
    <p class="text-gray-600 text-sm leading-relaxed">{description}</p>
  </div>
</div>
