---
import content from '../content.ts';
import criticalCssUrl from '../styles/critical.css?url';
import deferredCssUrl from '../styles/deferred.css?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${content.company_name} | Professional Painting Services in Delaware`,
  description = `${content.company_name} provides professional residential and commercial painting services in Dover, Middletown, Milford, and surrounding Delaware areas. Free estimates available.`
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WKX8XS3Q');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" /></noscript>
    
    <link rel="stylesheet" href={criticalCssUrl} />
    <link rel="stylesheet" href={deferredCssUrl} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={deferredCssUrl} /></noscript>

    <link rel="icon" type="image/png" href="/favicon.png" />
    
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Wali Painting & Handyman",
        "telephone": "(302) 296-6032",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "8 Little street Georgetown",
          "addressLocality": "Georgetown",
          "addressRegion": "DE",
          "postalCode": "19947"
        },
        "url": "https://walipainting.com",
        "areaServed": "Delaware"
      }
    </script>
  </head>
  <body class="bg-white text-gray-800 antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WKX8XS3Q"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      document.addEventListener('click', (event) => {
        const target = event.target;

        if (!(target instanceof Element)) {
          return;
        }

        const phoneTrigger = target.closest('[data-phone-event="true"]');

        if (!(phoneTrigger instanceof HTMLElement)) {
          return;
        }

        const label = phoneTrigger.dataset.phoneLabel?.trim() || phoneTrigger.textContent?.trim() || 'unknown';
        const phoneDisplay = phoneTrigger.dataset.phoneDisplay?.trim() || 'unknown';
        const phoneRole = phoneTrigger.dataset.phoneRole?.trim() || 'unknown';
        const phoneLocation = phoneTrigger.dataset.phoneLocation?.trim() || 'unknown';
        const phoneType = phoneTrigger.dataset.phoneType?.trim() || 'unknown';
        const href = phoneTrigger.getAttribute('href') || '';

        window.dataLayer.push({
          event: 'phone_click',
          phone_label: label,
          phone_display: phoneDisplay,
          phone_role: phoneRole,
          phone_location: phoneLocation,
          phone_type: phoneType,
          phone_href: href,
          click_text: phoneTrigger.textContent?.trim() || '',
          click_id: phoneTrigger.id || '',
          click_classes: phoneTrigger.className || ''
        });
      });
    </script>
  </body>
</html>
