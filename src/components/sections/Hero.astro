---
import content from '../../content.ts';
import LeadForm from '../ui/LeadForm.astro';
import { Image } from 'astro:assets';
import heroImg from '../../assets/images/hero/hero-bg.jpg';

const { company_name, company_phone, company_estimate, company_years_experience, company_license_insurance, hero_headline, hero_location, hero_subheadline, hero_cta_primary, hero_cta_secondary } = content;
---

<section id="hero" class="relative min-h-[500px] lg:min-h-screen flex items-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0 opacity-50 md:opacity-100">
    <Image
      src={heroImg}
      alt=""
      class="w-full h-full object-cover"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={80}
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/75 to-black/50 z-10"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left Column - Headline & CTA -->
      <div class="text-white">
        <h1 class="font-heading font-extrabold text-3xl md:text-5xl lg:text-6xl leading-tight mb-4 md:mb-6">
          { hero_headline + ' ' }
          { hero_location && (
            <span class="text-brand-primary">{ hero_location }</span>
          ) }
        </h1>
        
        <p class="text-base md:text-xl mb-6 leading-relaxed opacity-90">
          { hero_subheadline }
        </p>

        <!-- Trust Indicators -->
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:gap-4 mb-6 md:mb-8">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-primary" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
            <span class="text-sm font-medium">{ company_estimate }</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-primary" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
            <span class="text-sm font-medium">{ company_years_experience }</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-primary" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
            <span class="text-sm font-medium">{ company_license_insurance }</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a
            href="#lead-form"
            class="inline-flex items-center justify-center gap-2 bg-brand-primary hover:bg-brand-primary/90 text-white font-semibold px-8 py-4 rounded-lg transition-colors"
          >
            { hero_cta_primary }
          </a>
          <a
            href={`tel:${company_phone[0].replace(/[^0-9+]/g, '')}`}
            class="inline-flex items-center justify-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold px-8 py-4 rounded-lg transition-colors"
            data-phone-event="true"
            data-phone-label={hero_cta_secondary}
            data-phone-display={company_phone[0]}
            data-phone-role="secondary"
            data-phone-location="hero"
            data-phone-type="button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            { hero_cta_secondary }
          </a>
        </div>
      </div>

      <!-- Right Column - Lead Form -->
      <div id="lead-form" class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-2xl p-6 md:p-8">
        <div class="text-center mb-6">
          <h2 class="font-heading font-bold text-2xl text-brand-dark mb-2">Get a Free Quote</h2>
          <p class="text-gray-600 text-sm">Fill out the form below and we'll get back to you within 24 hours</p>
        </div>
        <LeadForm />
      </div>
    </div>
  </div>
</section>
